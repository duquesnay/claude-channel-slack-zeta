#!/usr/bin/env expect -f

# Launcher for claude --channels Slack daemon (claude_of_slack).
# Spawned by /Library/LaunchDaemons/ai.guillaume.claude-channel-slack-zeta.plist
# via run-channel.sh. Allocates a pty, dismisses the dev-channels confirmation
# prompt (Gotcha #1 in CLAUDE.md), then streams until claude exits — at which
# point launchd KeepAlive respawns us.

set timeout -1
log_user 1

cd /Users/guillaume/dev/nestor/ai-gateway-zeta

# Defensive cleanup: kill any orphan bun MCP processes from prior runs.
# Without this, restarts accumulate orphans (PPID=1 after parent claude
# died) that monopolize Slack Socket Mode (single-client per xapp- token)
# while their own claude is dead — events disappear into a black hole.
# Symptom: bot reactions still fire (old bun) but claude never sees the
# inbound notification (new bun connects but Slack delivers to oldest).
# See ~/.claude/projects/.../memory/feedback_zeta_orphan_bun.md.
exec pkill -f {bun.*ai-gateway-zeta/marketplace/external_plugins/slack-zeta}
sleep 1

# Fail-fast: if any bun MCP for this plugin survived the pkill (race or
# permission failure), exit non-zero. Letting launchd respawn after the
# zombie naturally dies is safer than spawning a silent-bot.
# macOS pgrep has no -c; pipe through wc. Pattern in single-quotes for sh.
set survivors [string trim [exec sh -c "pgrep -f 'bun.*ai-gateway-zeta/marketplace/external_plugins/slack-zeta' | wc -l"]]
if {$survivors > 0} {
    puts stderr "zeta-launcher: $survivors orphan bun MCP survived pkill — exiting (launchd will respawn)"
    exit 1
}

spawn /opt/homebrew/bin/claude \
    --resume claude_of_slack \
    --dangerously-load-development-channels plugin:slack-zeta@ai-gateway-zeta \
    --name claude_of_slack \
    --permission-mode auto \
    --allowedTools "mcp__plugin_slack-zeta_slack-zeta__*"

# Blind Enter sends to dismiss the dev-channels TUI confirmation.
# Robust against prompt-text changes; no-op if prompt no longer appears.
sleep 3
send "\r"
sleep 3
send "\r"

expect eof
