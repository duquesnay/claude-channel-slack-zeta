# Real values live in ~/.claude/channels/slack-zeta/.env (chmod 600)
# This file is here only as a reference for required env vars.

SLACK_BOT_TOKEN=xoxb-...      # Bot User OAuth Token (Install App page)
SLACK_APP_TOKEN=xapp-...      # App-Level Token, Socket Mode, scope connections:write

# Optional
# DISCORD_STATE_DIR=...       # override default state dir (~/.claude/channels/slack-zeta)
